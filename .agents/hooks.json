{
  "safety-policy": {
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|write_to_file|replace_file_content|multi_replace_file_content|invoke_subagent|define_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; python3 \"$ROOT/.agents/hooks/pre_tool_use_policy.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
