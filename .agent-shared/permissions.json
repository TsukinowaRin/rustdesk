{
  "_comment": "opencode.jsonc / kilo.jsonc の permission block の単一ソース。ここを編集して python3 scripts/sync_permissions.py で再生成する（drift 検査は --check、security_smoke.sh に組込み済み）。実効ポリシーは .agent-shared/hooks_core/common.py の hook 層と整合させる。",
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow",
      "*.env.template": "allow",
      ".env.example": "allow",
      ".env.sample": "allow",
      ".env.template": "allow",
      "*id_rsa*": "deny",
      "*aws/credentials*": "deny",
      "*.pem": "deny",
      "*.p12": "deny",
      "*.key": "deny"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow",
      "*.env.template": "allow",
      ".env.example": "allow",
      ".env.sample": "allow",
      ".env.template": "allow",
      "*id_rsa*": "deny",
      "*aws/credentials*": "deny",
      "*.pem": "deny",
      "*.p12": "deny",
      "*.key": "deny"
    },
    "bash": {
      "*": "allow",
      "rm -rf /": "deny",
      "rm -rf *": "deny",
      "sudo *": "ask",
      "sudo rm -rf*": "deny",
      "doas *": "ask",
      "pkexec *": "ask",
      "runas *": "ask",
      "*Start-Process*RunAs*": "ask",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny",
      "git push*": "ask",
      "mkfs*": "deny",
      "dd if=*": "deny",
      "curl *": "ask",
      "wget *": "ask",
      "git clone*": "ask",
      "gh repo clone*": "ask"
    },
    "skill": {
      "*": "allow"
    },
    "external_directory": {
      "*": "ask"
    },
    "task": "ask",
    "doom_loop": "ask"
  }
}
